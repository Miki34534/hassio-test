#!/usr/bin/execlineb -S1

# Выход если код завершения 0 или 256 (нормальное завершение)
foreground { redirfd -w 1 /dev/null echo "Shairport Sync exited with code ${1}" }
importas -i EXIT_CODE 1
ifelse { test ${EXIT_CODE} -eq 0 } { exit 0 }
ifelse { test ${EXIT_CODE} -eq 256 } { exit 0 }

# Для других кодов - пытаемся перезапустить
exit 125
