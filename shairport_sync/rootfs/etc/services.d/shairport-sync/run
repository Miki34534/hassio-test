#!/usr/bin/env bashio
# ==============================================================================
# Start Shairport Sync service
# ==============================================================================

bashio::log.info "Starting Shairport Sync with MQTT support..."

# Получаем конфигурацию
NAME=$(bashio::config 'airplay_name')
MQTT_ENABLED=$(bashio::config 'mqtt_enabled')
MQTT_HOSTNAME=$(bashio::config 'mqtt_hostname' 'core-mosquitto')
MQTT_PORT=$(bashio::config 'mqtt_port' '1883')
MQTT_TOPIC=$(bashio::config 'mqtt_topic' 'shairport')
MQTT_PUBLISH_PARSED=$(bashio::config 'mqtt_publish_parsed')
MQTT_PUBLISH_COVER=$(bashio::config 'mqtt_publish_cover')
MQTT_ENABLE_REMOTE=$(bashio::config 'mqtt_enable_remote')

bashio::log.info "AirPlay device name: ${NAME}"

# Создаём metadata pipe (FIFO) — это главное исправление!
rm -f /tmp/shairport-sync-metadata
mkfifo /tmp/shairport-sync-metadata
chmod 666 /tmp/shairport-sync-metadata
bashio::log.info "Metadata pipe created at /tmp/shairport-sync-metadata"

# Проверка доступности MQTT брокера (теперь здесь, где bashio точно работает)
if bashio::var.true "${MQTT_ENABLED}"; then
    bashio::log.info "MQTT enabled. Checking broker at ${MQTT_HOSTNAME}:${MQTT_PORT}..."
    if timeout 5 nc -z "${MQTT_HOSTNAME}" "${MQTT_PORT}" 2>/dev/null; then
        bashio::log.info "MQTT broker is available"
    else
        bashio::log.warning "Cannot connect to MQTT broker at ${MQTT_HOSTNAME}:${MQTT_PORT}"
        bashio::log.warning "Make sure Mosquitto broker addon is installed and running"
    fi
fi

# Создаем базовый конфигурационный файл
cat > /etc/shairport-sync.conf << EOF
general = {
    name = "${NAME}";
    output_backend = "alsa";
    port = 5000;
    udp_port_base = 6001;
    udp_port_range = 10;
};

alsa = {
    output_device = "default";
};

metadata = {
    enabled = "yes";
    include_cover_art = "yes";
    pipe_name = "/tmp/shairport-sync-metadata";
};
EOF

# Добавляем секцию MQTT если включено
if bashio::var.true "${MQTT_ENABLED}"; then
    bashio::log.info "Enabling MQTT integration..."
    bashio::log.info "MQTT Broker: ${MQTT_HOSTNAME}:${MQTT_PORT}"
    
    PARSED="no"
    COVER="no"
    REMOTE="no"
    
    bashio::var.true "${MQTT_PUBLISH_PARSED}" && PARSED="yes"
    bashio::var.true "${MQTT_PUBLISH_COVER}" && COVER="yes"
    bashio::var.true "${MQTT_ENABLE_REMOTE}" && REMOTE="yes"
    
    cat >> /etc/shairport-sync.conf << EOF

mqtt = {
    enabled = "yes";
    hostname = "${MQTT_HOSTNAME}";
    port = ${MQTT_PORT};
    topic = "${MQTT_TOPIC}";
    publish_parsed = "${PARSED}";
    publish_cover_art = "${COVER}";
    enable_remote_control = "${REMOTE}";
EOF

    # Добавляем аутентификацию MQTT если указана
    if bashio::config.has_value 'mqtt_username'; then
        MQTT_USERNAME=$(bashio::config 'mqtt_username')
        MQTT_PASSWORD=$(bashio::config 'mqtt_password')
        bashio::log.info "Using MQTT authentication"
        cat >> /etc/shairport-sync.conf << EOF
    username = "${MQTT_USERNAME}";
    password = "${MQTT_PASSWORD}";
EOF
    fi
    
    cat >> /etc/shairport-sync.conf << EOF
};
EOF
else
    bashio::log.info "MQTT is disabled"
fi

bashio::log.info "Starting Shairport Sync daemon..."

# Запускаем Shairport Sync
exec shairport-sync -c /etc/shairport-sync.conf -v
