{
  "name": "Shairport Sync",
  "version": "1.1.0",
  "slug": "shairport_sync",
  "description": "Shairport Sync for Home Assistant with MQTT support",
  "url": "https://github.com/Miki34534/hassio-test",
  "startup": "application",
  "arch": [
    "aarch64",
    "amd64",
    "armhf",
    "armv7",
    "i386"
  ],
  "boot": "auto",
  "init": false,
  "hassio_api": true,
  "homeassistant_api": true,
  "host_network": true,
  "hassio_role": "manager",
  "auth_api": true,
  "ingress": false,
  "panel_icon": "mdi:cast-audio",
  "audio": true,
  "full_access": true,
  "map": [
    "config:rw"
  ],
  "options": {
    "log_level": "info",
    "audio_device": "pulse",
    "pulse_sink": "alsa_output.usb-CSCTEK_USB_Audio_and_HID_A34004801402-00.analog-stereo",
    "avahi_interfaces": "",
    "avahi_hostname": "",
    "avahi_domainname": "local",
    "airplay_name": "Home Assistant",
    "enable_ipv6": false,
    "mqtt_enabled": true,
    "mqtt_hostname": "core-mosquitto",
    "mqtt_port": 1883,
    "mqtt_topic": "shairport",
    "mqtt_username": "",
    "mqtt_password": "",
    "mqtt_publish_parsed": true,
    "mqtt_publish_cover": true,
    "mqtt_enable_remote": true
  },
  "schema": {
    "log_level": "match(^(trace|debug|info|notice|warning|error|fatal)$)",
    "audio_device": "str?",
    "pulse_sink": "str?",
    "avahi_interfaces": "str?",
    "avahi_hostname": "str?",
    "avahi_domainname": "str?",
    "airplay_name": "str",
    "enable_ipv6": "bool",
    "mqtt_enabled": "bool",
    "mqtt_hostname": "str?",
    "mqtt_port": "port?",
    "mqtt_topic": "str?",
    "mqtt_username": "str?",
    "mqtt_password": "password?",
    "mqtt_publish_parsed": "bool?",
    "mqtt_publish_cover": "bool?",
    "mqtt_enable_remote": "bool?"
  },
  "environment": {
    "LOG_FORMAT": "{LEVEL}: {MESSAGE}"
  },
  "services": ["mqtt:want"]
}
